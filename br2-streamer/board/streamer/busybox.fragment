CONFIG_HTTPD=y
CONFIG_FEATURE_HTTPD_CGI=y
# BusyBox 1.38.0 restores directory index paths only with BASIC_AUTH enabled.
# No credentials are configured; this works around a root-URL 404 in CGI builds.
CONFIG_FEATURE_HTTPD_BASIC_AUTH=y
CONFIG_FEATURE_HTTPD_CONFIG_WITH_SCRIPT_INTERPR=y
CONFIG_TIMEOUT=y
# SSH password login: hash ssh_password from streamer.txt at boot (ssh-setup)
CONFIG_CRYPTPW=y
CONFIG_MKPASSWD=y
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y
# nc: the status page asks MPD (network player) what it is playing
CONFIG_NC=y
CONFIG_NC_EXTRA=y
