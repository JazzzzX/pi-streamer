# Streamer: sshd only runs when ssh_password is set in streamer.txt (see ssh-setup).
PermitRootLogin yes
PasswordAuthentication yes
KbdInteractiveAuthentication no
PubkeyAuthentication no
MaxAuthTries 4
HostKey /run/streamer-ssh/ssh_host_ed25519_key
HostKey /run/streamer-ssh/ssh_host_ecdsa_key
Subsystem sftp internal-sftp
